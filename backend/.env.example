# Backend only. Never put OpenAI/Meta secrets in the iOS app or Git.
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TRANSLATION_MODEL=gpt-4.1-mini
REALTIME_TRANSLATION_MODEL=gpt-realtime-translate
# The companion Realtime session that produces the original-language captions.
REALTIME_TRANSCRIPTION_SESSION_MODEL=gpt-realtime
REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe
MAX_UPLOAD_MB=20

# A separate random secret for your own app. Enter it in Connection settings.
# Generate locally: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
APP_ACCESS_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8003,http://127.0.0.1:8003

# Meta app dashboard / WhatsApp API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
# Choose your own random verify token and also enter it in Meta's webhook form.
WHATSAPP_VERIFY_TOKEN=
# Copy the supported Graph version shown by your Meta API Setup (e.g. vNN.N).
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TARGET_LANGUAGE=fr
# Optional comma-separated sender numbers, country code + digits (no '+').
# Set this to your test number to restrict who can trigger paid processing.
WHATSAPP_ALLOWED_SENDERS=
# Optional absolute SQLite file path; default: backend/data/inbox.sqlite3
# INBOX_DB_PATH=
